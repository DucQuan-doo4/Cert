# CertPrep Hub — Environment Variables
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# Database password (dùng cho PostgreSQL)
DB_PASSWORD=your_strong_password_here

# JWT Secret (dùng để mã hóa token đăng nhập - đặt chuỗi ngẫu nhiên dài)
JWT_SECRET=your_random_jwt_secret_here
